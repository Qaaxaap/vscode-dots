{
  // 由 nix 用 mkOutOfStoreSymlink 链接到 ~/.config/VSCodium/User/settings.json，
  // 在 UI 里改设置会直接写回这个文件（接入方式见本仓库 README）。
  "editor.fontFamily": "'Maple Mono NF CN','Droid Sans Mono', monospace",

  // 扩展由 nix 提供（--extensions-dir 指向只读的 store 目录），
  // 关掉自动更新/检查，免得每次启动都报写不进去。
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",

  // 编辑器本体由 nix/pacman 升级，不用它自己检查更新。
  "update.mode": "none",

  "telemetry.telemetryLevel": "off",

  // Vim 键位由 vscode-neovim 提供（见 extensions.nix）。这里只说一个 appname，
  // 不写任何路径：
  //   * nvim 可执行文件靠 PATH 找，home-manager 的 home.sessionPath 会把
  //     nix profile 的 bin 带进 GUI 会话；
  //   * NVIM_APPNAME=vscodium 让 nvim 去读 ~/.config/vscodium/init.lua，
  //     那份由本仓库的 nvim/init.lua 经 home-manager 链接过来，
  //     这样就不会加载 ~/.config/nvim 里的 LazyVim。
  "vscode-neovim.NVIM_APPNAME": "vscodium",

  // vscode-neovim 启动时会提示 “No affinity assigned”。affinity 是 VS Code
  // 自带的机制，用来把扩展分配到独立的扩展宿主进程；给它一个专属进程能降低
  // 按键延迟（UI 里点 Yes 写的就是这一条，值 1 是分组号）。
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  }
}
