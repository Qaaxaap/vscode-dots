{
  // 由 nix 用 mkOutOfStoreSymlink 链接到 ~/.config/VSCodium/User/settings.json，
  // 在 UI 里改设置会直接写回这个文件（接入方式见本仓库 README）。
  "editor.fontFamily": "'Maple Mono NF CN','Droid Sans Mono', monospace",

  // 扩展由 nix 提供（--extensions-dir 指向只读的 store 目录），
  // 关掉自动更新/检查，免得每次启动都报写不进去。
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",

  // 编辑器本体由 nix/pacman 升级，不用它自己检查更新。
  "update.mode": "none",

  "telemetry.telemetryLevel": "off"

  // Vim 键位由 vscode-neovim 提供（见 extensions.nix）。这里刻意不写任何路径：
  // nvim 靠 PATH 找，home-manager 的 home.sessionPath 会把 nix profile 的 bin
  // 带进 GUI 会话；init 用 nvim 自己的 ~/.config/nvim/init.lua，那份由
  // ~/nix/config/nvim-dots 链接管理，里面按 vim.g.vscode 分流到精简配置。
}
